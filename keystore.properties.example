# Example release-signing configuration for Killua IPTV.
#
# Copy this file to `keystore.properties` in the repository root and replace every placeholder
# with your own local values. `keystore.properties` is ignored by Git and must never be
# committed, uploaded, attached to an issue, placed in GitHub Actions Secrets, pasted into
# chat, or shown in a screenshot. This example file must keep placeholders only.
#
# Read docs/RELEASE.md before creating the permanent key. Losing or replacing it makes future
# updates to the installed production app impossible.

# Absolute path to the keystore. Keep it outside this repository and preferably outside the
# synced Proton Drive workspace, with at least two verified encrypted backups.
storeFile=C:/replace/with/a/path/outside/this/repository/killua-iptv-release.jks

# Passwords are read from this untracked file only. Never pass them on a command line, never
# echo them in Gradle output, and never store them in a remote secret service at this stage.
storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyAlias=REPLACE_WITH_YOUR_KEY_ALIAS
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD

# Passphrase for the Windows update signing key (tools/ReleaseSigning.java, Ed25519).
#
# Optional. Without it, signing a release asks at the console; with it, the release build signs
# without a person at the keyboard - the same trade this file already makes for the Android key.
#
# It is the passphrase to `update-signing.key`, not to the keystore above. They are different keys
# with different consequences: losing the Android one ends the app's update path for ever, losing
# this one means installed desktop clients stop accepting updates until they are reinstalled once.
updateSigningPassphrase=REPLACE_WITH_YOUR_UPDATE_SIGNING_PASSPHRASE
